{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js",
    ".opencode/plugins/whatsapp-guards.js"
  ],
  "instructions": [
    "AGENTS.md",
    "openspec/project.md",
    "CONTRIBUTING.md",
    "openspec/AGENTS.md"
  ],
  "formatter": true,
  "lsp": {
    "gopls": {
      "command": ["gopls", "serve"],
      "extensions": [".go"]
    }
  },
  "permission": {
    "bash": {
      "go test*": "allow",
      "go vet*": "allow",
      "gofmt*": "allow",
      "make build": "allow",
      "make test*": "allow",
      "make vet": "allow",
      "make smoke": "allow",
      "make graph-update": "allow",
      "npm test*": "allow",
      "npm run *": "allow",
      "node *": "allow",
      "openspec *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "gh *": "ask"
    }
  },
  "mcp": {
    "whatsapp-local": {
      "type": "remote",
      "url": "http://127.0.0.1:8765/mcp",
      "enabled": false
    }
  }
}
