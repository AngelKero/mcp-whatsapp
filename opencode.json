{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "instructions": ["AGENTS.md", "CONTRIBUTING.md", "openspec/AGENTS.md"],
  "formatter": true,
  "lsp": {
    "gopls": {
      "command": ["gopls", "serve"],
      "extensions": [".go"]
    }
  },
  "permission": {
    "bash": {
      "go test*": "allow",
      "go vet*": "allow",
      "gofmt*": "allow",
      "make build": "allow",
      "make test*": "allow",
      "make vet": "allow",
      "make smoke": "allow",
      "openspec list": "allow",
      "openspec status*": "allow",
      "openspec show*": "allow",
      "openspec validate*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow"
    }
  },
  "mcp": {
    "whatsapp-local": {
      "type": "remote",
      "url": "http://127.0.0.1:8765/mcp",
      "enabled": false
    }
  }
}
