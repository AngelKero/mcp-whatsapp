{
  "name": "mcp-whatsapp-automations",
  "version": "2.0.0",
  "description": "WhatsApp Multi-Agent Automations & RAG for CUCEA & macOS",
  "main": "whatsapp-watcher.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/unit/*.test.js test/e2e/*.test.js",
    "test:unit": "node --test --test-concurrency=1 test/unit/*.test.js",
    "test:scenarios": "node --test --test-concurrency=1 test/unit/openspec-scenarios.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.js",
    "test:go": "go test -v -tags \"sqlite_fts5\" ./internal/...",
    "vault": "node scripts/inspect-vault.js"
  },
  "dependencies": {
    "pdf-parse": "^2.4.5"
  }
}
